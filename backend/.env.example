# ===========================================================
# Copy this file to ".env" (same folder) and fill in YOUR values.
# Never commit the real .env file to git.
# ===========================================================

# Port the backend runs on
PORT=4000

# >>> YOUR DATABASE <<<
# MongoDB Atlas (or any MongoDB) connection string.
# Example: mongodb+srv://username:password@cluster0.mongodb.net/reclickmedia
MONGODB_URI=mongodb+srv://venkatanagesh61_db_user:GahDUBFnhPTiYAlZ@cluster0.kozfe6i.mongodb.net/?appName=Cluster0
# >>> YOUR EMAIL / NOTIFICATIONS <<<
# Used to email your team when someone submits the contact form.
# If using Gmail, create an "App Password" — don't use your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
NOTIFY_TO_EMAIL=hello@reclickmedia.com

# >>> ADMIN EXPORT KEY <<<
# A password you make up, required to download the contacts CSV export.
# Example usage: https://yourapi.com/api/contact/export?key=THIS_VALUE
ADMIN_EXPORT_KEY="reclickmedia_export_2026_950689"
# >>> FRONTEND ORIGIN (for CORS) <<<
# The URL your frontend is hosted on, so the API only accepts requests from it.
FRONTEND_ORIGIN=http://localhost:5500
